# Local output from the Cursor ingestion probe. It may contain prompts,
# filesystem paths, and file contents, so it must never be committed.
experiments/cursor-hook-probe/.local/
experiments/cursor-golden-session/.local/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
.e2e-artifacts/
*.egg-info/
.eggs/

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store

# Skillscope runtime data (sensitive: contains prompts and skill contents)
*.sqlite
*.jsonl
!tests/fixtures/**/*.jsonl

# Project-local Cursor hook capture config (copied from examples/ or experiments/)
.cursor/hooks.json

# Frontend
web/node_modules/
src/skillscope/web/dist/
