# Local output from the Cursor ingestion probe. It may contain prompts,
# filesystem paths, and file contents, so it must never be committed.
experiments/cursor-hook-probe/.local/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store

