{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -m skillscope.plugins.cursor.collector session_started",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 -m skillscope.plugins.cursor.collector task_submitted",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "python3 -m skillscope.plugins.cursor.collector read_succeeded",
        "matcher": "^(Read|ReadFile)$",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 -m skillscope.plugins.cursor.collector read_failed",
        "matcher": "^(Read|ReadFile)$",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 -m skillscope.plugins.cursor.collector session_ended",
        "timeout": 5
      }
    ]
  }
}
